# Copy to .env.local for local dev. In production set these in Vercel → Project → Settings → Environment Variables.
# Never commit real values. None of these are exposed to the browser (no NEXT_PUBLIC_ prefix).

# --- Gemini (classification) ---
GEMINI_API_KEY=
# fallback: gemini-3.7-flash (run `npm run check:gemini`)
GEMINI_MODEL=gemini-3.8-flash
# USD, from ai.google.dev/gemini-api/docs/pricing
GEMINI_INPUT_COST_PER_1M=0.75
# USD, output incl. thinking tokens
GEMINI_OUTPUT_COST_PER_1M=3.75
# for the cost tile (Vaani bills in INR)
USD_TO_INR=88

# --- Vaani Labs (voice) ---
VAANI_API_KEY=
# vv_whk_... shown once when the webhook is registered
VAANI_WEBHOOK_SECRET=
# INR per minute
VAANI_COST_PER_MIN=2.40

# --- Google Calendar (OAuth refresh token for the studio account) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=
CONSULT_DURATION_MIN=60
# bookable window, Asia/Kolkata
CONSULT_HOURS=10:00-19:00

# --- Supabase (server only) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Resend ---
RESEND_API_KEY=
# test sender: only delivers to the Resend account owner's email
EMAIL_FROM=onboarding@resend.dev
DESIGNER_NAME=
DESIGNER_EMAIL=
# Nikhil / studio head
ESCALATION_EMAIL=

# --- HubSpot ---
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_PIPELINE_ID=default
# internal stage id for "Consultation booked"  (npm run hubspot:stages)
HUBSPOT_STAGE_BOOKED=
# internal stage id for "New qualified lead"
HUBSPOT_STAGE_NEW=

# --- App ---
APP_BASE_URL=http://localhost:3000
# true = log Resend/HubSpot/Calendar payloads, don't send or book
DRY_RUN=true
