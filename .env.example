# Copy to .env.local for local dev; set the same names in Vercel → Project → Settings → Environment Variables.
# Values are intentionally empty. Blank optional values fall back to the defaults in src/lib/env.ts.
# Nothing here is exposed to the browser (no NEXT_PUBLIC_ prefix). Never commit real values.

# --- Vaani Labs ---
VAANI_API_KEY=
# Signing secret (vv_whk_...) shown once when the webhook is registered; verifies every Vaani request
VAANI_WEBHOOK_SECRET=
VAANI_PHONE_NUMBER=
# INR per minute, for the cost tile
VAANI_COST_PER_MIN=

# --- Gemini ---
GEMINI_API_KEY=
# Default gemini-3.8-flash; `npm run check:gemini` confirms access and tests the gemini-3.7-flash fallback
GEMINI_MODEL=
# INR per 1M tokens (output includes thinking tokens), for the cost tile
GEMINI_INPUT_COST_PER_1M=
GEMINI_OUTPUT_COST_PER_1M=

# --- Google Calendar (OAuth refresh token for the studio's Google account) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=
# Default 60
CONSULT_DURATION_MIN=
# Default 10:00-19:00, Asia/Kolkata
CONSULT_HOURS=

# --- Neon ---
# Pooled connection string (host contains -pooler, sslmode=require); used by the app
DATABASE_URL=
# Direct connection; used only by `npm run db:migrate`
DATABASE_URL_UNPOOLED=

# --- Resend ---
RESEND_API_KEY=
# Default onboarding@resend.dev: only delivers to the Resend account owner's email until a domain is verified
EMAIL_FROM=
# Used in "Hi {designer_name}"; blank → "Hi,"
DESIGNER_NAME=
DESIGNER_EMAIL=
# Nikhil / studio head
ESCALATION_EMAIL=

# --- HubSpot (Private App token) ---
HUBSPOT_ACCESS_TOKEN=

# --- App ---
# e.g. https://aangan-lead-desk.vercel.app
APP_BASE_URL=
# Default true. Only the literal "false" sends emails, pushes to HubSpot and books Calendar events.
DRY_RUN=
