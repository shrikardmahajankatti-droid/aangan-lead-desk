# Copy to .env.local for local dev. In production set these in Vercel → Project → Settings → Environment Variables.
# Never commit real values. None of these are exposed to the browser (no NEXT_PUBLIC_ prefix).

# --- Gemini (classification) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash          # fallback: gemini-3.7-flash (run `npm run check:gemini`)
GEMINI_INPUT_COST_PER_1M=0.75          # USD, from ai.google.dev/gemini-api/docs/pricing
GEMINI_OUTPUT_COST_PER_1M=3.75         # USD, output incl. thinking tokens
USD_TO_INR=88                          # for the cost tile (Vaani bills in INR)

# --- Vaani Labs (voice) ---
VAANI_API_KEY=
VAANI_WEBHOOK_SECRET=                  # vv_whk_... shown once when the webhook is registered
VAANI_COST_PER_MIN=2.40                # INR per minute

# --- Google Calendar (OAuth refresh token for the studio account) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=
CONSULT_DURATION_MIN=60
CONSULT_HOURS=10:00-19:00              # bookable window, Asia/Kolkata

# --- Supabase (server only) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Resend ---
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev       # test sender: only delivers to the Resend account owner's email
DESIGNER_NAME=
DESIGNER_EMAIL=
ESCALATION_EMAIL=                      # Nikhil / studio head

# --- HubSpot ---
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_PIPELINE_ID=default
HUBSPOT_STAGE_BOOKED=                  # internal stage id for "Consultation booked"  (npm run hubspot:stages)
HUBSPOT_STAGE_NEW=                     # internal stage id for "New qualified lead"

# --- App ---
APP_BASE_URL=http://localhost:3000
DRY_RUN=true                           # true = log Resend/HubSpot/Calendar payloads, don't send or book
