{
  "_note": "Agent: created/updated by `npm run vaani:config -- --apply`. Tools: Tools & Actions → New Action → Create Custom Tool, one per entry below, then attach to the agent. Webhook: Developers → Webhooks → Agent Webhook, Secret = VAANI_WEBHOOK_SECRET (signs X-Vaani-Signature over '{timestamp}.{body}').",
  "name": "Aangan Studio – Front Desk",
  "greeting": "Hello, Aangan Studio. How can I help you today?",
  "languages": [
    "en-IN",
    "hi-IN",
    "mr-IN"
  ],
  "language_policy": "Start in English; switch to the caller's language (Hindi/Marathi) if they use it. Use only languages Vaani supports.",
  "system_prompt_file": "vaani/system-prompt.md",
  "tools": [
    {
      "name": "aangan_qualify",
      "description": "Check the enquiry against the studio's rules. Call once area and scope are known, again after an ask_next answer, or immediately for an existing-client complaint.",
      "method": "POST",
      "url": "https://aangan-lead-desk.vercel.app/api/vaani/qualify",
      "timeout_ms": 4000,
      "headers": {
        "x-aangan-tool-secret": "<VAANI_WEBHOOK_SECRET — paste from clipboard, never commit>"
      },
      "parameters": {
        "type": "object",
        "properties": {
          "caller_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "location": {
            "type": [
              "string",
              "null"
            ]
          },
          "property_type": {
            "type": [
              "string",
              "null"
            ]
          },
          "sq_ft": {
            "type": [
              "number",
              "null"
            ]
          },
          "bhk": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "scope": {
            "type": [
              "string",
              "null"
            ]
          },
          "scope_extent": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "full",
                  "partial",
                  "unknown"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "rooms_in_scope": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "segment": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "residential",
                  "commercial"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "timeline": {
            "type": [
              "string",
              "null"
            ]
          },
          "decision_maker": {
            "type": [
              "string",
              "null"
            ]
          },
          "volunteered_budget_lakh": {
            "type": [
              "number",
              "null"
            ]
          },
          "is_existing_client_complaint": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    {
      "name": "aangan_get_slots",
      "description": "Get three open consultation times (next 7 days, studio hours). Only after qualify returned offer_booking: true.",
      "method": "POST",
      "url": "https://aangan-lead-desk.vercel.app/api/vaani/slots",
      "timeout_ms": 4000,
      "headers": {
        "x-aangan-tool-secret": "<VAANI_WEBHOOK_SECRET — paste from clipboard, never commit>"
      },
      "parameters": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "aangan_book_slot",
      "description": "Book the consultation the caller chose. Re-checks the time is still free and sends calendar invites.",
      "method": "POST",
      "url": "https://aangan-lead-desk.vercel.app/api/vaani/book",
      "timeout_ms": 4000,
      "headers": {
        "x-aangan-tool-secret": "<VAANI_WEBHOOK_SECRET — paste from clipboard, never commit>"
      },
      "parameters": {
        "type": "object",
        "properties": {
          "slot_id": {
            "type": "string",
            "description": "slot_id from get_slots"
          },
          "caller_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "location": {
            "type": [
              "string",
              "null"
            ]
          },
          "caller_email": {
            "description": "Only if the caller gave one",
            "type": [
              "string",
              "null"
            ]
          },
          "caller_phone": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "slot_id"
        ]
      }
    }
  ],
  "tool_response_shape": "JSON; the agent should speak the `say` field (map $.say to a variable if the dashboard asks).",
  "webhook": {
    "type": "Agent Webhook",
    "url": "https://aangan-lead-desk.vercel.app/api/vaani/call-ended",
    "secret": "VAANI_WEBHOOK_SECRET",
    "events_used": [
      "call_started",
      "call_postprocessing"
    ]
  }
}
