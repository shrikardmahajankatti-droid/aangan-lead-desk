{
  "name": "aangan-lead-desk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check:gemini": "node --env-file=.env.local scripts/check-gemini.mjs",
    "check:vaani": "node --env-file=.env.local scripts/check-vaani.mjs",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx --env-file=.env.local scripts/migrate.ts",
    "test": "vitest run",
    "seed": "tsx --conditions=react-server --env-file=.env.local scripts/seed.ts",
    "show": "tsx --conditions=react-server --env-file=.env.local scripts/show-calls.ts",
    "deliver": "tsx --conditions=react-server --env-file=.env.local scripts/deliver.ts",
    "hubspot:setup": "tsx --conditions=react-server --env-file=.env.local scripts/hubspot-setup.ts",
    "google:auth": "tsx --env-file=.env.local scripts/google-auth.ts",
    "calendar:check": "tsx --conditions=react-server --env-file=.env.local scripts/calendar-check.ts",
    "vaani:config": "tsx --conditions=react-server --env-file=.env.local scripts/vaani-setup.ts"
  },
  "dependencies": {
    "@google/genai": "^2.28.0",
    "@googleapis/calendar": "^20.1.0",
    "@hubspot/api-client": "^14.0.1",
    "@neondatabase/serverless": "^1.2.0",
    "google-auth-library": "^11.2.0",
    "next": "16.4.0",
    "pdf-parse": "^2.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "^6.32.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "pg": "^8.23.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
